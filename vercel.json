{
  "buildCommand": "cd dashboard && npm install && npm run build",
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/dashboard$",
      "dest": "/dashboard/dist/index.html"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "/dashboard/dist/$1"
    },
    {
      "handle": "filesystem"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
